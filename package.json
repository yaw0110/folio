{
  "name": "folio",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "bin": {
    "mdp": "./bin/folio.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "template-store.js",
    "pdf-export.js",
    "server.js",
    "src",
    "README.md",
    "CONTEXT.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "dev": "vite",
    "dev:desktop": "npm run build && electron .",
    "build": "vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:pkg": "npm run build && electron-builder --mac pkg",
    "dist:win": "npm run build && electron-builder --win",
    "start": "npm run build && node bin/folio.js",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "vite": "^6.2.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.folio.app",
    "productName": "Folio",
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "templates/**/*",
      "src/render.js",
      "README.md",
      "server.js",
      "template-store.js",
      "pdf-export.js",
      "electron/main.cjs",
      "package.json"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": ["dmg", "pkg"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "fileAssociations": [{
      "ext": "md",
      "name": "Markdown document",
      "description": "Folio Markdown document",
      "role": "Editor"
    }]
  }
}
